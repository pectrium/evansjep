{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/work/jeclazon",
      "destination": "/work/pectrium",
      "permanent": true
    },
    {
      "source": "/work/quincestone",
      "destination": "/work/pectrium",
      "permanent": true
    },
    {
      "source": "/work/emperor-armani",
      "destination": "/work/pectrium",
      "permanent": true
    }
  ]
}
